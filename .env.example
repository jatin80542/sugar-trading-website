# ============================================================
# Copy this file to .env.local and fill in ONE delivery method.
# Until you do, the enquiry form returns an honest error instead
# of pretending the message was sent.
#
#   cp .env.example .env.local
# ============================================================

# --- OPTION A: send the enquiry to any webhook (easiest) -----
# Works with Zapier, Make, n8n, Slack, Google Apps Script,
# or your own API. Receives the full enquiry as JSON.
# ENQUIRY_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/000000/abcdef

# --- OPTION B: send the enquiry as an email via Resend -------
# Sign up free at resend.com and verify your sending domain.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# ENQUIRY_TO_EMAIL=trade@yourdomain.com
# ENQUIRY_FROM_EMAIL=website@yourdomain.com
